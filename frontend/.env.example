# Server-only. Configure in Vercel; never add a REACT_APP_ prefix.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Production Blob (OIDC is injected automatically by Vercel)
BLOB_STORE_ID=
# Separate preview Blob, connected to Preview only
PREVIEW_BLOB_STORE_ID=
# Optional local-only fallback; never use a public Blob store
BLOB_READ_WRITE_TOKEN=
